{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/src/hook.ts\" --session-start || true",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/src/hook.ts\" || true",
            "timeout": 15,
            "statusMessage": "記憶を思い出しています..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${CLAUDE_PLUGIN_ROOT}/src/hook.ts\" --learn || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
